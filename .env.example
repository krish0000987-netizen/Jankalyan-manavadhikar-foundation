# Jankalyan Manavadhikar Foundation - Environment Configuration Example
# Copy this file to .env and provide your deployment credentials.

# -----------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# NOTE: Only Anon / Publishable keys are safe for browser exposure.
# NEVER put service_role secret keys in VITE_* variables.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

VITE_APP_NAME="Jankalyan Manavadhikar Foundation"
VITE_DEFAULT_ACADEMIC_YEAR="2026-27"
VITE_PORTAL_VERSION="2.0.0"

# -----------------------------------------------------------------------------
# Server-Side / Edge Functions Configuration (Privileged Secrets)
# Configure these in Supabase Dashboard -> Settings -> Secrets or Edge Functions.
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here
# PAYMENT_GATEWAY_KEY_ID=rzp_live_xxxxxxxx
# PAYMENT_GATEWAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# PAYMENT_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# SMS_GATEWAY_API_KEY=xxxxxxxxxxxxxxxx
# WHATSAPP_API_TOKEN=xxxxxxxxxxxxxxxx
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=xxxxxxxx
